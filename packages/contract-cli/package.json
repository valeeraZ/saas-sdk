{
  "name": "@frame/contract-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "frame-contract": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/check.d.ts",
      "import": "./dist/check.js",
      "default": "./dist/check.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@frame/manifest-schema": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.10.0"
  }
}
