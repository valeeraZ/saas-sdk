{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "incremental": false,
    "rewriteRelativeImportExtensions": true
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/test-fixture.ts",
    "dist",
    "node_modules"
  ]
}
